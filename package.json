{
  "name": "neon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check dist/app.js && node --check dist/engine.js",
    "build": "node build.mjs",
    "test:fork": "node --test tests/fork.integration.mjs",
    "build:lab": "node scripts/build-lab.mjs",
    "testnet": "node scripts/build-lab.mjs && node scripts/lab-server.mjs",
    "check:mainnet": "node scripts/check-mainnet.mjs",
    "test:orders": "node --test tests/orders.fork.integration.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:consumer": "node scripts/consumer-check.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "ganache": "7.9.2"
  },
  "packageManager": "pnpm@11.19.0",
  "license": "MIT"
}
